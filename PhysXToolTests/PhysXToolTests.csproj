<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>14</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
        <InvariantGlobalization>true</InvariantGlobalization>
        <RootNamespace>Tests</RootNamespace>
        <PublishAot>true</PublishAot>
        <OptimizationPreference>Speed</OptimizationPreference>
        <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
        <XunitEnableSourceGenerators>true</XunitEnableSourceGenerators>
        <XunitAutoGeneratedEntryPoint>true</XunitAutoGeneratedEntryPoint>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\PhysXTool\PhysXTool.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="xunit.v3.aot.mtp-v2" Version="4.0.1" />
        <PackageReference Include="xunit.v3.assert.aot" Version="4.0.1" />
        <PackageReference Include="xunit.v3.runner.utility.aot" Version="4.0.1" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
        <PackageReference Include="coverlet.collector" Version="10.1.0">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="ReportGenerator" Version="5.5.11" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="Xunit"/>
    </ItemGroup>

</Project>
