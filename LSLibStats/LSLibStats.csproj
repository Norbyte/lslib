<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>annotations</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\LSLib\LSLib.csproj" />
    <PackageReference Include="YaccLexTools.Gppg" Version="1.5.3.1" />
    <PackageReference Include="YaccLexTools.Gplex" Version="1.2.3.1" />
  </ItemGroup>

  <ItemGroup>
    <YaccFile Include="Stats\File\Stat.yy" />
    <LexFile Include="Stats\File\Stat.lex">
      <Arguments>/noEmbedBuffers</Arguments>
    </LexFile>
    <YaccFile Include="Stats\Functor\Functor.yy" />
    <LexFile Include="Stats\Functor\Functor.lex">
      <Arguments>/noEmbedBuffers</Arguments>
    </LexFile>
    <YaccFile Include="Stats\Functor\Lua.yy" />
    <LexFile Include="Stats\Functor\Lua.lex">
      <Arguments>/noEmbedBuffers</Arguments>
    </LexFile>
    <YaccFile Include="Stats\Functor\Expression.yy" />
    <LexFile Include="Stats\Functor\Expression.lex">
      <Arguments>/noEmbedBuffers</Arguments>
    </LexFile>
    <YaccFile Include="Stats\Functor\Requirement.yy" />
    <LexFile Include="Stats\Functor\Requirement.lex">
      <Arguments>/noEmbedBuffers</Arguments>
    </LexFile>
    <YaccFile Include="Stats\Functor\RollConditions.yy" />
    <LexFile Include="Stats\Functor\RollConditions.lex">
      <Arguments>/noEmbedBuffers</Arguments>
    </LexFile>
  </ItemGroup>

  <!--
    The GPPG/GPLEX runtime (ShiftReduceParserCode.cs, GplexBuffers.cs) is compiled into LSLib and
    exported (EXPORT_GPPG); this project consumes those public types. Exclude the local copies the
    YaccLexTools targets emit so the runtime isn't duplicated across assemblies.
  -->
  <Target Name="UseSharedGppgRuntime" AfterTargets="YaccLexToolsGppgSingleTarget;YaccLexToolsGplexSingleTarget" BeforeTargets="CoreCompile">
    <ItemGroup>
      <Compile Remove="ShiftReduceParserCode.cs" />
      <Compile Remove="GplexBuffers.cs" />
    </ItemGroup>
  </Target>

</Project>
